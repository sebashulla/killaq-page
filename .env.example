NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Solo servidor: nunca usar NEXT_PUBLIC ni publicar valores.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY= (alternativa legacy)
COMPLAINTS_HASH_SECRET=
COMPLAINTS_TEAM_EMAIL=
COMPLAINTS_FROM_EMAIL=
RESEND_API_KEY=
CRON_SECRET=
# JSON de identidad, operaciones y aprobación. Vacío mantiene cerrada la publicación.
KILLAQ_LEGAL_CONFIG={}

# Analítica: todo es SOLO SERVIDOR. Desactivada hasta revisión y producción.
ANALYTICS_ENABLED=false
ANALYTICS_PRIVACY_APPROVED=false
ANALYTICS_RETENTION_APPROVED=false
ANALYTICS_HASH_SECRET=
ANALYTICS_PUBLIC_HOST=killaq-page.vercel.app
# Fecha real de inicio del esquema v1, YYYY-MM-DD; no completar con una fecha ficticia.
ANALYTICS_MEASUREMENT_START=
ANALYTICS_UTM_CAMPAIGNS=
POSTHOG_REGION=eu
POSTHOG_PROJECT_KEY=
POSTHOG_PROJECT_ID=
# Clave personal con el alcance mínimo de lectura de consultas. Nunca NEXT_PUBLIC.
POSTHOG_PERSONAL_API_KEY=
# Solo enlace privado del administrador: no instala el script de Clarity.
CLARITY_PROJECT_ID=

# Opcionales: feed automático. Vacíos usan la selección de Admin > Redes y videos.
# Tokens del titular, con permisos de lectura. Nunca NEXT_PUBLIC ni incluirlos en enlaces.
TIKTOK_DISPLAY_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Versión vigente aprobada para la app de Meta, por ejemplo vNN.0; no activar sin verificar.
INSTAGRAM_API_VERSION=
